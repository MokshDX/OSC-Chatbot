{"nodes": [{"id": "docs_handbook_leave_policy_annualleaveaccrual", "label": "Annual leave accrual and carryover", "file_type": "concept", "source_file": "docs/handbook/leave-policy.md", "source_location": "6-13", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "26 days per calendar year on top of public holidays, credited monthly at 2.166 days from the first day of employment. Up to 10 unused days carry over and expire on 31 March without payout, which bounds the accrued liability on the balance sheet."}, {"id": "docs_handbook_leave_policy_leaveapprovalworkflow", "label": "Leave request approval workflow", "file_type": "concept", "source_file": "docs/handbook/leave-policy.md", "source_location": "15-18", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Five consecutive days or fewer needs only the direct manager; longer requests additionally need the department head and 21 days notice, so team coverage can be arranged."}, {"id": "docs_handbook_leave_policy_sickleave", "label": "Sick leave", "file_type": "concept", "source_file": "docs/handbook/leave-policy.md", "source_location": "20-30", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "12 fully paid days per calendar year, non-accruing and non-carrying. A medical certificate is required beyond three consecutive working days; shorter absences need only a notification before 10:00 on day one. Sickness during approved annual leave can be reclassified with a certificate so holiday is not lost to illness."}, {"id": "docs_handbook_leave_policy_parentalleave", "label": "Parental leave", "file_type": "concept", "source_file": "docs/handbook/leave-policy.md", "source_location": "32-39", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "18 paid weeks for primary caregivers, 6 for secondary, taken within 12 months of birth or placement, in up to three blocks with manager agreement and 8 weeks notice."}, {"id": "docs_handbook_leave_policy_unpaidleave", "label": "Unpaid leave", "file_type": "concept", "source_file": "docs/handbook/leave-policy.md", "source_location": "41-45", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Up to three months at department head discretion, only once accrued annual leave is exhausted. Benefits continue but pension contributions are suspended."}, {"id": "docs_handbook_leave_policy_publicholidays", "label": "Public holidays", "file_type": "concept", "source_file": "docs/handbook/leave-policy.md", "source_location": "47-51", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Holidays follow the employee's country of residence; for cross-region workers the contracting entity's calendar applies, giving one unambiguous calendar per employee."}, {"id": "docs_handbook_leave_policy_sabbatical", "label": "Sabbatical", "file_type": "concept", "source_file": "docs/handbook/leave-policy.md", "source_location": "53-55", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Four weeks paid, requestable after five years of continuous service."}], "edges": [{"source": "docs_handbook_leave_policy_leaveapprovalworkflow", "target": "docs_handbook_leave_policy_annualleaveaccrual", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/handbook/leave-policy.md", "source_location": "15-18", "weight": 1.0}, {"source": "docs_handbook_leave_policy_sickleave", "target": "docs_handbook_leave_policy_annualleaveaccrual", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/handbook/leave-policy.md", "source_location": "29-30", "weight": 1.0}, {"source": "docs_handbook_leave_policy_unpaidleave", "target": "docs_handbook_leave_policy_annualleaveaccrual", "relation": "references", "confidence": "EXTRACTED", "conf