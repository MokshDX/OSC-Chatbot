{"nodes": [{"id": "docs_engineering_deployment_runbook_deploymentwindow", "label": "Production deployment window", "file_type": "concept", "source_file": "docs/engineering/deployment-runbook.md", "source_location": "5-12", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Monday to Thursday 09:00-16:00 CET. Friday deploys are blocked because the on-call rotation thins over the weekend and a Friday regression is typically only discovered on Monday. Emergency fixes need on-call engineering manager approval recorded in the incident channel."}, {"id": "docs_engineering_deployment_runbook_predeploymentchecklist", "label": "Pre-deployment checklist", "file_type": "concept", "source_file": "docs/engineering/deployment-runbook.md", "source_location": "14-19", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Green CI, second-engineer migration review, written rollback plan and feature flags off in production - each item removes one class of decision from the moment of an incident."}, {"id": "docs_engineering_deployment_runbook_bluegreendeployment", "label": "Blue-green deployment strategy", "file_type": "concept", "source_file": "docs/engineering/deployment-runbook.md", "source_location": "21-24", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The new revision runs alongside the current one and receives no traffic until its health check passes, so a failed start never reaches a user and rollback is a traffic shift rather than a redeploy."}, {"id": "docs_engineering_deployment_runbook_trafficshiftstages", "label": "Staged traffic shift and automatic abort", "file_type": "concept", "source_file": "docs/engineering/deployment-runbook.md", "source_location": "26-28", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "10 percent for 10 minutes, then 50 percent for 10 minutes, then 100 percent, watching error rate and p95 latency. An error rate above 2 percent aborts automatically so the blast radius is bounded without a human in the loop."}, {"id": "docs_engineering_deployment_runbook_backwardcompatiblemigrations", "label": "Backward-compatible database migrations", "file_type": "concept", "source_file": "docs/engineering/deployment-runbook.md", "source_location": "30-32", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Migrations run before the new revision takes traffic, so during the shift both revisions read the same schema; a migration that cannot be made backward compatible is split across two releases."}, {"id": "docs_engineering_deployment_runbook_rollbackprocedure", "label": "Rollback procedure", "file_type": "concept", "source_file": "docs/engineering/deployment-runbook.md", "source_location": "34-38", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rollback is a traffic shift to the previous revision, under two minutes, and is always the first response to a regression: traffic is made safe first and diagnosis happens afterwards."}, {"id": "docs_engineering_deployment_runbook_forwardfixformigrations", "label": "Forward fix for migrations (never auto-rollback)", "file_type": "rationale", "source_file": "docs/engineering/deployment-runbook.md", "source_location": "40-41", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Migrations are never rolled back automatically because reversing a migration that has already accepted writes loses data; a forward fix is written instead."}, {"id": "docs_engineering_deployment_runbook_postdeploymentmonitoring", "label": "Post-deployment monitoring and release log", "file_type": "concept", "source_file": "docs/engineering/deployment-runbook.md", "source_location": "43-46", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dashboards are watched 30 minutes past full traffic and the release is recorded with commit SHA, deployer and outcome, so a later incident can be tied to a specific revision."}], "edges": [{"source": "docs_engineering_deployment_runbook_bluegreendeployment", "target": "docs_engineering_deployment_runbook_trafficshiftstages", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/engineering/deployment-runbook.md", "source_location": "23-28", "weight": 1.0}, {"source": "docs_engineering_deployment_runbook_rollbackprocedure", "target": "docs_engineering_deployment_runbook_bluegreendeployment", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/engineering/deployment-runbook.md", "source_location": "36-38", "weight": 1.0}, {"source": "docs_engineering_deployment_runbook_forwardfixformigrations", "target": "docs_engineering_deployment_runbook_rollbackprocedure", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/engineering/deployment-runbook.md", "source_location": "40-41", "weight": 1.0}, {"source": "docs_engineering_deployment_runbook_forwardfixformigrations", "target": "docs_engineering_deployment_runbook_backwardcompatiblemigrations", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/engineering/deployment-runbook.md", "source_location": "30-41", "weight": 1.0}, {"source": "docs_engineering_deployment_runbook_backwardcompatiblemigrations", "target": "docs_engineering_deployment_runbook_trafficshiftstages", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/engineering/deployment-runbook.md", "source_location": "30-32", "weight": 1.0}, {"source": "docs_engineering_deployment_runbook_predeploymentchecklist", "target": "docs_engineering_deployment_runbook_rollbackprocedure", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/engineering/deployment-runbook.md", "source_location": "18", "weight": 1.0}, {"source": "docs_engineering_deployment_runbook_predeploymentchecklist", "target": "docs_engineering_deployment_runbook_backwardcompatiblemigrations", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/engineering/deployment-runbook.md", "source_location": "17,30-32", "weight": 1.0}, {"source": "docs_engineering_deployment_runbook_postdeploymentmonitoring", "target": "docs_engineering_deployment_runbook_trafficshiftstages", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/engineering/deployment-runbook.md", "source_location": "45", "weight": 1.0}, {"source": "docs_engineering_deployment_runbook_deploymentwindow", "target": "docs_engineering_deployment_runbook_postdeploymentmonitoring", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "docs/engineering/deployment-runbook.md", "source_location": "7-9,45", "weight": 1.0}, {"source": "docs_engineering_deployment_runbook_rollbackprocedure", "target": "docs_engineering_incident_response_severitylevels", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/engineering/deployment-runbook.md", "source_location": "34-38", "weight": 1.0}, {"source": "docs_engineering_deployment_runbook_deploymentwindow", "target": "docs_engineering_incident_response_sev1", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "docs/engineering/deployment-runbook.md", "source_location": "7-12", "weight": 1.0}, {"source": "docs_engineering_deployment_runbook_trafficshiftstages", "target": "docs_security_access_control_standard_privilegedaccess", "relation": "conceptually_related_to", "confidence": "AMBIGUOUS", "confidence_score": 0.25, "source_file": "docs/engineering/deployment-runbook.md", "sourc