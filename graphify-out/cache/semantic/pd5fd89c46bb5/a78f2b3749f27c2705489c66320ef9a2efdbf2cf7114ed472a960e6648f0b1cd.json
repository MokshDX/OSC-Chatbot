{"nodes": [{"id": "src_osc_assistant_api_static_index_knowledgeassistantui", "label": "OSC Knowledge Assistant Web UI", "file_type": "code", "source_file": "src/osc_assistant/api/static/index.html", "source_location": "1-229", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deliberately one self-contained file with no build step and no framework, imported by nothing in the backend, so the whole UI can be replaced by swapping the single file. A richer client is the expected path."}, {"id": "src_osc_assistant_api_static_index_el", "label": "el (element factory)", "file_type": "code", "source_file": "src/osc_assistant/api/static/index.html", "source_location": "123-128", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_osc_assistant_api_static_index_rendersources", "label": "renderSources", "file_type": "code", "source_file": "src/osc_assistant/api/static/index.html", "source_location": "130-142", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Re-renders the whole source list on every citation event rather than patching one node, because a citation can arrive for any already-rendered source and full replace is cheaper to reason about than diffing."}, {"id": "src_osc_assistant_api_static_index_submithandler", "label": "Chat form submit handler", "file_type": "code", "source_file": "src/osc_assistant/api/static/index.html", "source_location": "144-224", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_osc_assistant_api_static_index_healthbanner", "label": "Health check status banner", "file_type": "code", "source_file": "src/osc_assistant/api/static/index.html", "source_location": "118-121", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Surfaces llm provider/model, embedding model, vector store provider and retrieval strategy from GET /api/health so the operator can see which configuration answered a question without reading server config."}, {"id": "src_osc_assistant_api_static_index_ssestreamprotocol", "label": "SSE chat stream protocol (sources/delta/citation/complete/error)", "file_type": "concept", "source_file": "src/osc_assistant/api/static/index.html", "source_location": "184-215", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Frames are separated by a blank line and a partial frame stays buffered, so the client can decode arbitrary chunk boundaries from the reader without a framing library."}, {"id": "src_osc_assistant_api_static_index_completeeventauthority", "label": "Complete event is authoritative", "file_type": "rationale", "source_file": "src/osc_assistant/api/static/index.html", "source_location": "15-17", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The one rule worth preserving on a rewrite: the complete event replaces whatever streamed. When it reports an abstention the client must discard already-rendered delta text and drop the source list, because the assistant declined to answer and streamed fragments would read as a partial answer."}, {"id": "src_osc_assistant_api_static_index_nohistorysent", "label": "Conversation history deliberately not sent", "file_type": "rationale", "source_file": "src/osc_assistant/api/static/index.html", "source_location": "169-171", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Query rewriting is disabled by default, so sending history would make a follow-up retrieve against an unresolved reference. Single-turn requests keep retrieval grounded until rewriting exists."}, {"id": "src_osc_assistant_api_static_index_groundedanswercontract", "label": "Grounded answer / abstention contract", "file_type": "concept", "source_file": "src/osc_assistant/api/static/index.html", "source_location": "97-101", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Answers are generated only from retrieved sources with citations; if the corpus lacks the answer the assistant says so rather than guessing. The UI states this up front so users read an abstention as correct behaviour, not failure."}], "edges": [{"source": "src_osc_assistant_api_static_index_submithandler", "target": "src_osc_assistant_api_static_index_rendersources", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/osc_assistant/api/static/index.html", "source_location": "197,204,210", "weight": 1.0}, {"source": "src_osc_assistant_api_static_index_submithandler", "target": "src_osc_assistant_api_static_index_el", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/osc_assistant/api/static/index.html", "source_location": "153-156", "weight": 1.0}, {"source": "src_osc_assistant_api_static_index_rendersources", "target": "src_osc_assistant_api_static_index_el", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/osc_assistant/api/static/index.html", "source_location": "133-139", "weight": 1.0}, {"source": "src_osc_assistant_api_static_index_submithandler", "target": "src_osc_assistant_api_static_index_ssestreamprotocol", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/osc_assistant/api/static/index.html", "source_location": "184-215", "weight": 1.0}, {"source": "src_osc_assistant_api_static_index_rendersources", "target": "src_osc_assistant_api_static_index_ssestreamprotocol", "relation": "shares_data_with", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "src/osc_assistant/api/static/index.html", "source_location": "130-142", "weight": 1.0}, {"source": "src_osc_assistant_api_static_index_completeeventauthority", "target": "src_osc_assistant_api_static_index_submithandler", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/osc_assistant/api/static/index.html", "source_location": "205-210", "weight": 1.0}, {"source": "src_osc_assistant_api_static_index_nohistorysent", "target": "src_osc_assistant_api_static_index_submithandler", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/osc_assistant/api/static/index.html", "source_location": "169-171", "weight": 1.0}, {"source": "src_osc_assistant_api_static_index_knowledgeassistantui", "target": "src_osc_assistant_api_static_index_submithandler", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/osc_assistant/api/static/index.html", "source_location": "106-110", "weight": 1.0}, {"source": "src_osc_assistant_api_static_index_knowledgeassistantui", "target": "src_osc_assistant_api_static_index_healthbanner", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/osc_assistant/api/static/index.html", "source_location": "92,118-121", "weight": 1.0}, {"source": "src_osc_assistant_api_static_index_completeeventauthority", "target": "src_osc_assistant_api_static_index_groundedanswercontract", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/osc_assistant/api/static/index.html", "source_location": "15-17,97-101", "weight": 1.0}, {"source": "src_osc_assistant_api_static_index_groundedanswercontract", "target": "src_osc_assistant_api_static_index_rendersources", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "src/osc_assistant/api/static/index.html", "source_location": "97-101,130-142", "weight": 1.0}, {"source": "src_osc_assistant_api_static_index_knowledgeassistantui", "target": "docs_handbook_leave_policy_annualleaveaccrual", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "src/osc_assistant/api/