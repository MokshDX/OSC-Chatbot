{"nodes": [{"id": "docs_engineering_incident_response_severitylevels", "label": "Incident severity levels", "file_type": "concept", "source_file": "docs/engineering/incident-response.txt", "source_location": "6-21", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Severity is defined by customer impact and workaround availability rather than by component, so response time can be set without debating ownership."}, {"id": "docs_engineering_incident_response_sev1", "label": "SEV1", "file_type": "concept", "source_file": "docs/engineering/incident-response.txt", "source_location": "9-12", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Complete loss of a customer-facing service, confirmed data loss or a confirmed security breach. 15 minute response 24/7, incident commander appointed, executive notification mandatory."}, {"id": "docs_engineering_incident_response_sev2", "label": "SEV2", "file_type": "concept", "source_file": "docs/engineering/incident-response.txt", "source_location": "14-16", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Major functionality degraded for many customers with no workaround. 30 minute response in business hours, 1 hour outside."}, {"id": "docs_engineering_incident_response_sev3", "label": "SEV3", "file_type": "concept", "source_file": "docs/engineering/incident-response.txt", "source_location": "17-18", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Minor degradation or a workaround exists; response by the next business day."}, {"id": "docs_engineering_incident_response_sev4", "label": "SEV4", "file_type": "concept", "source_file": "docs/engineering/incident-response.txt", "source_location": "20-21", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cosmetic or single-customer report with no service impact; handled in the normal backlog."}, {"id": "docs_engineering_incident_response_incidentcommander", "label": "Incident Commander", "file_type": "concept", "source_file": "docs/engineering/incident-response.txt", "source_location": "26-29", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single decision maker who coordinates and does not debug; for SEV1 the IC must not also be the primary responder, because a debugging IC stops coordinating exactly when coordination matters most."}, {"id": "docs_engineering_incident_response_communicationslead", "label": "Communications Lead", "file_type": "concept", "source_file": "docs/engineering/incident-response.txt", "source_location": "31-32", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Owns all internal and customer updates; required for SEV1 and SEV2 so responders are not interrupted to write status posts."}, {"id": "docs_engineering_incident_response_scribe", "label": "Scribe", "file_type": "concept", "source_file": "docs/engineering/incident-response.txt", "source_location": "34-35", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keeps a timestamped log of actions and decisions, required for SEV1 - the record the postmortem is later reconstructed from."}, {"id": "docs_engineering_incident_response_communicationcadence", "label": "Incident communication cadence", "file_type": "concept", "source_file": "docs/engineering/incident-response.txt", "source_location": "36-44", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SEV1 every 30 minutes to the incident channel and the customer status page, SEV2 every 2 hours in business hours, SEV3/SEV4 on resolution only."}, {"id": "docs_engineering_incident_response_blamelesspostmortem", "label": "Blameless postmortem", "file_type": "concept", "source_file": "docs/engineering/incident-response.txt", "source_location": "46-56", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mandatory for SEV1 and SEV2 within 5 business days. Postmortems describe what the system did and what conditions allowed it, not who made a mistake, so responders report accurately; every action item has a named owner, a due date and backlog tracking. SEV1 postmortems are reviewed in weekly engineering leadership."}], "edges": [{"source": "docs_engineering_incident_response_severitylevels", "target": "docs_engineering_incident_response_sev1", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/engineering/incident-response.txt", "source_location": "9-12", "weight": 1.0}, {"source": "docs_engineering_incident_response_severitylevels", "target": "docs_engineering_incident_response_sev2", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/engineering/incident-response.txt", "source_location": "14-16", "weight": 1.0}, {"source": "docs_engineering_incident_response_severitylevels", "target": "docs_engineering_incident_response_sev3", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/engineering/incident-response.txt", "source_location": "17-18", "weight": 1.0}, {"source": "docs_engineering_incident_response_severitylevels", "target": "docs_engineering_incident_response_sev4", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/engineering/incident-response.txt", "source_location": "20-21", "weight": 1.0}, {"source": "docs_engineering_incident_response_sev1", "target": "docs_engineering_incident_response_incidentcommander", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/engineering/incident-response.txt", "source_location": "11,28-29", "weight": 1.0}, {"source": "docs_engineering_incident_response_sev1", "target": "docs_engineering_incident_response_scribe", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/engineering/incident-response.txt", "source_location": "34-35", "weight": 1.0}, {"source": "docs_engineering_incident_response_sev1", "target": "docs_engineering_incident_response_communicationslead", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/engineering/incident-response.txt", "source_location": "31-32", "weight": 1.0}, {"source": "docs_engineering_incident_response_sev2", "target": "docs_engineering_incident_response_communicationslead", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/engineering/incident-response.txt", "source_location": "31-32", "weight": 1.0}, {"source": "docs_engineering_incident_response_communicationcadence", "target": "docs_engineering_incident_response_communicationslead", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/engineering/incident-response.txt", "source_location": "31-44", "weight": 1.0}, {"source": "docs_engineering_incident_response_communicationcadence", "target": "docs_engineering_incident_response_sev1", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/engineering/incident-response.txt", "source_location": "39-41", "weight": 1.0}, {"source": "docs_engineering_incident_response_blamelesspostmortem", "target": "docs_engineering_incident_response_sev1", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/engineering/incident-response.txt", "source_location": "49-56", "weight": 1.0}, {"source": "docs_engineering_incident_response_blamelesspostmortem", "target": "docs_engineering_incident_response_sev2", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/engineering/incident-response.txt", "source_location": "49-50", "w