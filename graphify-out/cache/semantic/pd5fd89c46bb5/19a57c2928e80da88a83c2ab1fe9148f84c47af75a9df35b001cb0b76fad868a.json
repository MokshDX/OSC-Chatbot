{"nodes": [{"id": "docs_handbook_expenses_policy_expensesubmissionwindow", "label": "60-day expense submission window", "file_type": "concept", "source_file": "docs/handbook/expenses-policy.md", "source_location": "3-8", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Claims go through the Expense Portal within 60 days of the cost; later claims need written justification plus finance director approval and may be declined, keeping the accounting period closable."}, {"id": "docs_handbook_expenses_policy_receiptrequirement", "label": "Itemised receipt requirement", "file_type": "concept", "source_file": "docs/handbook/expenses-policy.md", "source_location": "10-12", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Card statements are not evidence because they do not itemise. Expenses under 25 EUR are exempt, capped at 100 EUR per employee per month, so the exemption cannot become a routine channel."}, {"id": "docs_handbook_expenses_policy_approvalthresholds", "label": "Expense approval thresholds", "file_type": "concept", "source_file": "docs/handbook/expenses-policy.md", "source_location": "14-22", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Up to 500 EUR direct manager, 500-2,500 EUR department head, above 2,500 EUR finance director. Items above 2,500 EUR must be approved before the cost is incurred; retrospective approval is never granted, so the approver still has a real choice."}, {"id": "docs_handbook_expenses_policy_travelclassrules", "label": "Flight class rules", "file_type": "concept", "source_file": "docs/handbook/expenses-policy.md", "source_location": "24-28", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Economy under six hours, premium economy at six hours or longer, business class only with finance director approval regardless of duration."}, {"id": "docs_handbook_expenses_policy_accommodationcaps", "label": "Accommodation caps", "file_type": "concept", "source_file": "docs/handbook/expenses-policy.md", "source_location": "30-32", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "180 EUR per night in tier-one cities (London, Zurich, New York, Singapore, Tokyo) and 120 EUR elsewhere; local tourist taxes sit outside the cap and are reimbursed in full because they are not discretionary."}, {"id": "docs_handbook_expenses_policy_railpreference", "label": "Rail preferred under five hours door-to-door", "file_type": "concept", "source_file": "docs/handbook/expenses-policy.md", "source_location": "34-35", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_handbook_expenses_policy_mealallowance", "label": "Daily meal allowance", "file_type": "concept", "source_file": "docs/handbook/expenses-policy.md", "source_location": "37-41", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "65 EUR tier-one, 45 EUR elsewhere. Explicitly a cap on reimbursable spend rather than a per diem payment - only actual documented spend is reimbursed."}, {"id": "docs_handbook_expenses_policy_cliententertainment", "label": "Client entertainment rules", "file_type": "concept", "source_file": "docs/handbook/expenses-policy.md", "source_location": "43-44", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Needs prior department head approval and a record of the names and employers of all attendees, which is what makes the spend auditable against anti-bribery expectations."}, {"id": "docs_handbook_expenses_policy_nonreimbursableitems", "label": "Non-reimbursable expenses", "file_type": "concept", "source_file": "docs/handbook/expenses-policy.md", "source_location": "46-50", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never reimbursed: traffic and parking fines, duty-free purchases, personal travel insurance, hotel minibar and loyalty-programme fees."}], "edges": [{"source": "docs_handbook_expenses_policy_approvalthresholds", "target": "docs_handbook_expenses_policy_travelclassrules", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/handbook/expenses-policy.md", "source_location": "27-28", "weight": 1.0}, {"source": "docs_handbook_expenses_policy_cliententertainment", "target": "docs_handbook_expenses_policy_approvalthresholds", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/handbook/expenses-policy.md", "source_location": "43-44", "weight": 1.0}, {"source": "docs_handbook_expenses_policy_accommodationcaps", "target": "docs_handbook_expenses_policy_mealallowance", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/handbook/expenses-policy.md", "source_location": "30-39", "weight": 1.0}, {"source": "docs_handbook_expenses_policy_railpreference", "target": "docs_handbook_expenses_policy_travelclassrules", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/handbook/expenses-policy.md", "source_location": "24-35", "weight": 1.0}, {"source": "docs_handbook_expenses_policy_receiptrequirement", "target": "docs_handbook_expenses_policy_expensesubmissionwindow", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/handbook/expenses-policy.md", "source_location": "5-12", "weight": 1.0}, {"source": "docs_handbook_expenses_policy_expensesubmissionwindow", "target": "docs_handbook_expenses_policy_approvalthresholds", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/handbook/expenses-policy.md", "source_location": "7-8,19", "weight": 1.0}, {"source": "docs_handbook_expenses_policy_nonreimbursableitems", "target": "docs_handbook_expenses_policy_receiptrequirement", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "docs/handbook/expenses-policy.md", "source_location": "10-12,46-50", "weight": 1.0}, {"source": "docs_handbook_expenses_policy_mealallowance", "target": "docs_handbook_expenses_policy_receiptrequirement", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/handbook/expenses-policy.md", "source_location": "39-41", "weight": 1.0}], "hyperedges": []}