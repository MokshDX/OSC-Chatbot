{"nodes": [{"id": "docs_engineering_data_retention_retentionschedule", "label": "OSC Data Retention Schedule", "file_type": "document", "source_file": "docs/engineering/data-retention.pdf", "source_location": "page 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Owned by Legal and Compliance; applies to all systems processing OSC or customer data. Defines how long each data category is held and what happens at end of life."}, {"id": "docs_engineering_data_retention_retentionpurpose", "label": "Retention balance rationale", "file_type": "rationale", "source_file": "docs/engineering/data-retention.pdf", "source_location": "page 1, section 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Retaining data longer than necessary increases breach impact and regulatory exposure, while deleting it too early destroys records OSC is legally required to hold. Every period in the schedule is a point between those two failures."}, {"id": "docs_engineering_data_retention_customeraccountrecords", "label": "Customer account records (7 years)", "file_type": "concept", "source_file": "docs/engineering/data-retention.pdf", "source_location": "page 1, section 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Held 7 years after account closure. The period comes from financial record-keeping obligations and cannot be shortened by a deletion request."}, {"id": "docs_engineering_data_retention_applicationlogs", "label": "Application logs (90 days hot, 12 months total)", "file_type": "concept", "source_file": "docs/engineering/data-retention.pdf", "source_location": "page 1, section 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "90 days hot storage plus 275 days cold, totalling 12 months - recent debugging stays fast while the long tail stays cheap."}, {"id": "docs_engineering_data_retention_securityauditlogs", "label": "Security audit logs (24 months, append-only)", "file_type": "concept", "source_file": "docs/engineering/data-retention.pdf", "source_location": "page 1, section 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Written to append-only storage and not modifiable or deletable before 24 months expire, so the audit trail survives an attacker who reaches the systems it records."}, {"id": "docs_engineering_data_retention_communicationsrecords", "label": "Email and instant messaging records (3 years)", "file_type": "concept", "source_file": "docs/engineering/data-retention.pdf", "source_location": "page 1, section 2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_engineering_data_retention_recruitmentrecords", "label": "Recruitment records (12 or 24 months)", "file_type": "concept", "source_file": "docs/engineering/data-retention.pdf", "source_location": "page 1, section 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unsuccessful candidate records are deleted after 12 months unless the candidate consented to a 24 month talent-pool retention - the longer period requires explicit consent rather than being the default."}, {"id": "docs_engineering_data_retention_backupsnapshots", "label": "Backup snapshots (35 days)", "file_type": "concept", "source_file": "docs/engineering/data-retention.pdf", "source_location": "page 1, section 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A deletion request is satisfied once the record leaves live systems; backups are never edited to remove individual records and instead age out naturally within 35 days, because surgically rewriting backups would destroy their restorability."}, {"id": "docs_engineering_data_retention_deletionprocess", "label": "End-of-life deletion process", "file_type": "concept", "source_file": "docs/engineering/data-retention.pdf", "source_location": "page 1, section 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deletion is permanent and irreversible; records are destroyed rather than anonymised unless the Data Protection Officer has approved a specific analytical need. Jobs run on the first Sunday of each month and a failed deletion raises a SEV3 incident that must be resolved before the next monthly run."}, {"id": "docs_engineering_data_retention_legalhold", "label": "Legal hold", "file_type": "concept", "source_file": "docs/engineering/data-retention.pdf", "source_location": "page 1, section 4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A legal hold suspends all deletion for covered records, including scheduled end-of-life deletion, and is applied and released only by the General Counsel. Held records are retained until release however long that takes, so the schedule can never destroy evidence."}], "edges": [{"source": "docs_engineering_data_retention_retentionschedule", "target": "docs_engineering_data_retention_customeraccountrecords", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/engineering/data-retention.pdf", "source_location": "page 1, section 2", "weight": 1.0}, {"source": "docs_engineering_data_retention_retentionschedule", "target": "docs_engineering_data_retention_applicationlogs", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/engineering/data-retention.pdf", "source_location": "page 1, section 2", "weight": 1.0}, {"source": "docs_engineering_data_retention_retentionschedule", "target": "docs_engineering_data_retention_securityauditlogs", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/engineering/data-retention.pdf", "source_location": "page 1, section 2", "weight": 1.0}, {"source": "docs_engineering_data_retenti