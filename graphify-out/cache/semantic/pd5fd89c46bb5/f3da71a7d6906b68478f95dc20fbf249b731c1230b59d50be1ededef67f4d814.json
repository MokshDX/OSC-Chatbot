: "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/engineering/data-retention.pdf", "source_location": "page 1, section 4", "weight": 1.0}, {"source": "docs_engineering_data_retention_deletionprocess", "target": "docs_engineering_data_retention_customeraccountrecords", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/engineering/data-retention.pdf", "source_location": "page 1, sections 2-3", "weight": 1.0}, {"source": "docs_engineering_data_retention_securityauditlogs", "target": "docs_engineering_data_retention_deletionprocess", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/engineering/data-retention.pdf", "source_location": "page 1, sections 2-3", "weight": 1.0}, {"source": "docs_engineering_data_retention_deletionprocess", "target": "docs_engineering_incident_response_sev3", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/engineering/data-retention.pdf", "source_location": "page 1, section 3", "weight": 1.0}, {"source": "docs_engineering_data_retention_securityauditlogs", "target": "docs_security_access_control_standard_privilegedaccess", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/engineering/data-retention.pdf", "source_location": "page 1, section 2", "weight": 1.0}, {"source": "docs_engineering_data_retention_securityauditlogs", "target": "docs_security_access_control_standard_accessreviews", "relation": "shares_data_with", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "docs/engineering/data-retention.pdf", "source_location": "page 1, section 2", "weight": 1.0}, {"source": "docs_engineering_data_retention_retentionpurpose", "target": "docs_security_access_control_standard_leastprivilege", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/