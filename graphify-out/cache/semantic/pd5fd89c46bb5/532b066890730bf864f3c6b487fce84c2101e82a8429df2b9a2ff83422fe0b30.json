{"nodes": [{"id": "docs_security_access_control_standard_leastprivilege", "label": "Principle of least privilege", "file_type": "concept", "source_file": "docs/security/access-control-standard.html", "source_location": "19-24", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every account gets the minimum access its role needs, and access is granted to groups rather than individual accounts so entitlements can be reasoned about and revoked as a unit."}, {"id": "docs_security_access_control_standard_accessreviews", "label": "Periodic access reviews", "file_type": "concept", "source_file": "docs/security/access-control-standard.html", "source_location": "26-37", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Confidential-or-higher systems quarterly, Internal annually. Reviews are run by the system owner rather than the security team because only the owner knows whether an entitlement is still justified; anything the reviewer cannot justify is revoked by default, and reviews must complete within 15 working days."}, {"id": "docs_security_access_control_standard_joinersmoversleavers", "label": "Joiners, movers and leavers", "file_type": "concept", "source_file": "docs/security/access-control-standard.html", "source_location": "39-51", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Joiner access is provisioned no earlier than the start date; role changes revoke prior entitlements within 5 working days because additive-only role changes are the most common source of excessive privilege at OSC; all access is revoked within 4 hours of a confirmed departure and immediately for an involuntary one."}, {"id": "docs_security_access_control_standard_privilegedaccess", "label": "Privileged production access", "file_type": "concept", "source_file": "docs/security/access-control-standard.html", "source_location": "53-59", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hardware MFA plus just-in-time grants of at most 8 hours; standing production administrative access is not permitted for any role, so a compromised account is rarely privileged at the moment of compromise."}, {"id": "docs_security_access_control_standard_serviceaccounts", "label": "Service account controls", "file_type": "concept", "source_file": "docs/security/access-control-standard.html", "source_location": "61-66", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every service account has a named human owner and credentials rotate every 90 days. Interactive use is forbidden and alerted on, because interactive use of a service account is the signature of credential theft."}], "edges": [{"source": "docs_security_access_control_standard_accessreviews", "target": "docs_security_access_control_standard_leastprivilege", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/security/access-control-standard.html", "source_location": "26-37", "weight": 1.0}, {"source": "docs_security_access_control_standard_joinersmoversleavers", "target": "docs_security_access_control_standard_leastprivilege", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/security/access-control-standard.html", "source_location": "42-46", "weight": 1.0}, {"source": "docs_security_access_control_standard_privilegedaccess", "target": "docs_security_access_control_standard_leastprivilege", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/security/access-control-standard.html", "source_location": "53-59", "weight": 1.0}, {"source": "docs_security_access_control_standard_serviceaccounts", "target": "docs_security_access_control_standard_leastprivilege", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "docs/security/access-control-standard.html", "source_location": "61-66", "weight": 1.0}, {"source": "docs_security_access_control_standard_joinersmoversleavers", "target": "docs_security_access_control_standard_accessreviews", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/security/access-control-standard.html", "source_location": "26-51", "weight": 1.0}, {"source": "docs_security_access_control_standard_accessreviews", "target": "docs_engineering_incident_response_blamelesspostmortem", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.65, "source_file": "docs/security/access-control-standard.html", "source_location": "26-37", "weight": 1.0}, {"source": "docs_security_access_control_standard_joinersmoversleavers", "target": "docs_handbook_leave_policy_unpaidleave", "relation": "conceptually_related_to", "confidence": "AMBIGUOUS", "confidence_score": 0.25, "source_file": "docs/security/access-control-standard.html", "source_location": "39-51", "weight": 1.0}], "hyperedges": []}