# Copy to .env. The default profile is fully local and needs NO credential at all;
# everything below is either an override or a key for a provider you opt into.

# --- Service -----------------------------------------------------------------
OSC_ENVIRONMENT=development
OSC_LOG_LEVEL=INFO

# PostgreSQL with the pgvector extension. Set this if your database is not the
# one in config/default.yaml.
# OSC_DATABASE__DSN=postgresql://mokshdutt@localhost:5432/osc

# --- Hosted provider credentials ---------------------------------------------
# Only needed if you switch a component away from the local Ollama default.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# VOYAGE_API_KEY=
# HF_TOKEN=

# --- Overrides ---------------------------------------------------------------
# Any profile value can be overridden here; nesting uses a double underscore.
# OSC_LLM__MODEL=qwen3:14b
# OSC_RETRIEVAL__TOP_K=8
# OSC_PROFILE=config/experiments/hosted-anthropic.yaml
