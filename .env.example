# Copy to .env. Only the providers you actually configure need a credential.

# --- Answer / embedding providers -------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
VOYAGE_API_KEY=
HF_TOKEN=

# --- Service -----------------------------------------------------------------
OSC_ENVIRONMENT=development
OSC_LOG_LEVEL=INFO
OSC_DATABASE__DSN=postgresql://postgres:postgres@localhost:5432/osc_assistant

# --- Overrides ---------------------------------------------------------------
# Any profile value can be overridden here; nesting uses a double underscore.
# OSC_LLM__PROVIDER=groq
# OSC_LLM__MODEL=llama-3.3-70b-versatile
# OSC_PROFILE=config/experiments/local-only.yaml
